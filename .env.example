# ---- Server ----
PORT=4000
NODE_ENV=development
APP_BASE_URL=http://localhost:4000

# ---- MySQL ----
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=takeoff_user
DB_PASSWORD=Tadiwa@2003
DB_NAME=takeoff_onboarding

# ---- Auth ----
# Generate a strong random value, e.g: openssl rand -hex 32
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# ---- OTP ----
# OTP_MODE = "test" | "twilio"
#   test   -> no SMS sent. A fixed/logged code is accepted (see README "Test OTP mode").
#   twilio -> real SMS sent via Twilio Verify.
OTP_MODE=test
OTP_TEST_CODE=123456
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5

# ---- Twilio Verify (only required when OTP_MODE=twilio) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# ---- Uploads ----
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# ---- Admin bootstrap (used by `npm run seed`) ----
ADMIN_EMAIL=admin@takeoff.local
ADMIN_PASSWORD=Admin@12345
ADMIN_PHONE=+10000000000
