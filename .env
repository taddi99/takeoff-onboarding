OTP_TEST_CODE=123456
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5

# ---- Twilio Verify (only required when OTP_MODE=twilio) ----
TWILIO_ACCOUNT_SID=ACa2126975c2b9d8c0
